generator client {
  provider = "prisma-client-js"
}

// SQLite is used for zero-setup demo reliability. Enums are represented as
// String columns validated against shared domain constants (see src/types/domain.ts).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & RBAC
// ============================================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  role          String
  region        String?
  institutionId String?
  designation   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution          Institution?     @relation(fields: [institutionId], references: [id])
  applications         Application[]    @relation("AssignedOfficer")
  auditLogs            AuditLog[]
  notifications        Notification[]
  evcMemberships       EvcMember[]
  workflowActions      WorkflowAction[]
  undertakingsVerified Undertaking[]    @relation("VerifiedBy")
  documentsVerified    Document[]       @relation("VerifiedBy")

  @@index([role])
  @@index([region])
}

// ============================================================
// INSTITUTIONS
// ============================================================

model Institution {
  id               String   @id @default(uuid())
  name             String
  aisheCode        String   @unique
  type             String
  region           String
  state            String
  address          String?
  contactEmail     String?
  contactPhone     String?
  isNewInstitution Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users        User[]
  applications Application[]
  documents    Document[]

  @@index([region])
}

// ============================================================
// RULES ENGINE (rules as data - versioned JSON)
// ============================================================

model RuleConfig {
  id          String   @id @default(uuid())
  type        String
  version     Int
  name        String
  description String?
  config      String
  isActive    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([type, version])
  @@index([type, isActive])
}

// ============================================================
// APPLICATIONS & WORKFLOW
// ============================================================

model Application {
  id                String    @id @default(uuid())
  applicationNumber String    @unique
  institutionId     String
  academicYear      String
  programType       String
  status            String    @default("DRAFT")
  currentStage      String    @default("SUBMISSION")
  routeType         String    @default("SCRUTINY_EVC")
  assignedOfficerId String?
  assignedRegion    String
  submittedAt       DateTime?
  decisionAt        DateTime?
  slaDueAt          DateTime?
  isBreached        Boolean   @default(false)
  isHumanVerified   Boolean   @default(false)
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  institution     Institution      @relation(fields: [institutionId], references: [id])
  assignedOfficer User?            @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])
  actions         WorkflowAction[]
  undertakings    Undertaking[]
  evcSchedules    EvcSchedule[]
  alerts          Alert[]
  documents       Document[]

  @@index([status])
  @@index([currentStage])
  @@index([assignedRegion])
  @@index([assignedOfficerId])
}

model WorkflowAction {
  id            String   @id @default(uuid())
  applicationId String
  actorId       String?
  actionType    String
  fromStage     String?
  toStage       String?
  fromStatus    String?
  toStatus      String?
  reason        String?
  metadata      String?
  isAutomated   Boolean  @default(false)
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id])
  actor       User?       @relation(fields: [actorId], references: [id])

  @@index([applicationId])
  @@index([createdAt])
}

// ============================================================
// EVC SCHEDULING
// ============================================================

model EvcSchedule {
  id            String    @id @default(uuid())
  applicationId String
  status        String    @default("QUEUED")
  scheduledDate DateTime?
  completedDate DateTime?
  venue         String?
  meetingLink   String?
  queuedAt      DateTime  @default(now())
  dueAt         DateTime?
  isBreached    Boolean   @default(false)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id])
  members     EvcMember[]

  @@index([status])
  @@index([scheduledDate])
}

model EvcMember {
  id            String   @id @default(uuid())
  evcScheduleId String
  userId        String
  isAvailable   Boolean  @default(true)
  role          String?
  createdAt     DateTime @default(now())

  evcSchedule EvcSchedule @relation(fields: [evcScheduleId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@index([evcScheduleId])
  @@index([userId])
}

// ============================================================
// TIME-BOUND UNDERTAKINGS & COMPLIANCE
// ============================================================

model Undertaking {
  id                  String    @id @default(uuid())
  applicationId       String
  title               String
  description         String
  conditions          String
  dueDate             DateTime
  status              String    @default("PENDING")
  submittedAt         DateTime?
  verifiedAt          DateTime?
  verifiedById        String?
  evidencePath        String?
  verificationRemarks String?
  remindersSent       Int       @default(0)
  escalated           Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id])
  verifiedBy  User?       @relation("VerifiedBy", fields: [verifiedById], references: [id])

  @@index([status])
  @@index([dueDate])
  @@index([applicationId])
}

// ============================================================
// DOCUMENTS & LEASE VALIDITY
// ============================================================

model Document {
  id                  String    @id @default(uuid())
  institutionId       String
  applicationId       String?
  type                String
  title               String
  filePath            String
  issuedDate          DateTime?
  validFrom           DateTime?
  validUntil          DateTime?
  status              String    @default("VALID")
  renewalSubmittedAt  DateTime?
  renewedUntil        DateTime?
  expiryAlertSent     Boolean   @default(false)
  escalated           Boolean   @default(false)
  verifiedAt          DateTime?
  verifiedById        String?
  verificationRemarks String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  institution Institution  @relation(fields: [institutionId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id])
  verifiedBy  User?        @relation("VerifiedBy", fields: [verifiedById], references: [id])

  @@index([status])
  @@index([validUntil])
  @@index([institutionId])
}

// ============================================================
// ALERTS, NOTIFICATIONS & ESCALATION
// ============================================================

model Alert {
  id            String   @id @default(uuid())
  type          String
  severity      String   @default("INFO")
  title         String
  message       String
  applicationId String?
  entityType    String?
  entityId      String?
  recipientRole String?
  recipientId   String?
  /// Owning institution, set for alerts raised against an institution's
  /// documents or undertakings so they can be scoped to that institution.
  institutionId String?
  isRead        Boolean  @default(false)
  isEscalated   Boolean  @default(false)
  escalatedTo   String?
  metadata      String?
  createdAt     DateTime @default(now())

  application Application? @relation(fields: [applicationId], references: [id])

  @@index([type])
  @@index([severity])
  @@index([isRead])
  @@index([createdAt])
  @@index([institutionId])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String?
  channel    String    @default("IN_APP")
  status     String    @default("QUEUED")
  subject    String
  body       String
  templateId String?
  metadata   String?
  sentAt     DateTime?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([channel])
}

model Escalation {
  id         String    @id @default(uuid())
  entityType String
  entityId   String
  reason     String
  fromRole   String?
  toRole     String
  toUserId   String?
  level      Int       @default(1)
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  metadata   String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([resolved])
}

// ============================================================
// AUDIT TRAIL (immutable)
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userRole   String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
