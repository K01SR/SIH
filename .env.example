# Copy to .env and adjust for your deployment.
# Used by docker-compose.yml.

# Secret used to sign JWTs. MUST be at least 16 characters in production.
JWT_SECRET=change-me-in-production-min-16-chars

# Public URL of the client (used for CORS).
CLIENT_URL=http://localhost:8080

# Seed demo data on first start.
SEED_ON_START=true
