# Copy to .env and adjust for your deployment.
# Used by docker-compose.yml.

# Secret used to sign JWTs. MUST be at least 16 characters in production.
JWT_SECRET=change-me-in-production-min-16-chars

# Public URL of the client (used for CORS). Must match the published client URL.
CLIENT_URL=http://localhost:8080

# Host ports. Change these if 8080/4000 are already in use.
CLIENT_PORT=8080
SERVER_PORT=4000

# Seed demo data only when the database has no users yet.
SEED_ON_START=true

# Set true to wipe and reseed an existing database on the next start.
# Destructive: removes all applications, users, documents and audit history.
SEED_FORCE=false

# Workflow scheduler (alerts / SLA escalation).
ENABLE_SCHEDULER=true
ESCALATION_CRON="*/5 * * * *"
JWT_EXPIRES_IN=8h
